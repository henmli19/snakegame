<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="anchorPane"
            onKeyPressed="#moveSquareKeyPressed"
            prefHeight="600.0" prefWidth="600.0"
            style="-fx-background-image: url('/grass.jpg');
       -fx-background-size: cover;"
            xmlns="http://javafx.com/javafx/15.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.henrimlika.snakegame.HelloController">
    <Button fx:id="startButton" layoutX="32.0" layoutY="34.0"
            onKeyPressed="#moveSquareKeyPressed"
            onMouseClicked="#start" text="Begin"/>
</AnchorPane>

